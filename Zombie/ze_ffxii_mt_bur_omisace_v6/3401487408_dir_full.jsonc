          },
          {
            "output": "OnUser2",
            "target": "[PR#]cmd",
            "input": "Command",
            "param": "say **[Bash] On the understanding that Kiltia's followers would exempt themselves from political dealings in other lands**",
            "delay": 10,
            "limit": -1
          },
          {
            "output": "OnUser2",
            "target": "[PR#]cmd",
            "input": "Command",
            "param": "say **[Bash] In its long history Mt Bur-Omisace has never fallen under the control of any foreign power**",
            "delay": 6,
            "limit": -1
          },
          {
            "output": "OnUser2",
            "target": "[PR#]cmd",
            "input": "Command",
            "param": "say **[Bash] Kingdom and Empire both formed a pact to guarantee the holy city's independence",
            "delay": 3,
            "limit": -1
          }
        ]
